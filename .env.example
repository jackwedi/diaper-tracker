# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "service_role" (secrète, utilisée uniquement côté serveur)
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe partagé pour accéder à l'app (laisser vide = pas de protection)
APP_PASSWORD=
# Chaîne aléatoire longue (ex : `openssl rand -hex 32`)
AUTH_SECRET=
